<launch>
  <!-- 15 机编队仿真（GUI）：由 bashs/gen_multi_uav_ego_15sim.py 生成，勿手改。
       seed=714824895；改参数请编辑脚本后重新生成。
       模型：UAV1..UAV15 -> iris_0..iris_14（ID = ID_in_group = 0..14）
       empty world 地理原点：lat=38.49859707 lon=103.20623996 alt=1401 m
       参考朝向 yaw=-65.0°（0 = +x），5 排 × 3 列，间距 5.0 m，向右/向后展开：
         第5排: UAV13 UAV14 UAV15
         第4排: UAV10 UAV11 UAV12
         第3排: UAV7 UAV8 UAV9
         第2排: UAV4 UAV5 UAV6
         第1排: UAV1 UAV2 UAV3
       摆放误差：x/y ±0.8 m，z = 0.5 + δz（|δz| ≤ 0.4 m），偏航 ±12.0°
       端口：mavlink_tcp_port = 4560 + ID，udp_gimbal_port = 13030 + ID（ID = UAVn-1）
       生成顺序：spawn_model -wait 前一模型，按 iris_0..iris_14 依次插入 Gazebo
       用法（终端 A，仿真 Master 11300）：
         export ROS_MASTER_URI=http://localhost:11300
         export GAZEBO_MASTER_URI=http://localhost:11345
         roslaunch swarm_simulation multi_uav_ego_15sim.launch
       机载层各自 Master 用 startup_offboard_ego.sh 启动（UAV1..15 -> 11311..11325）
       PX4 实例 0..14、MAV_SYS_ID 1..15，与既有启动脚本和端口公式一致。
  -->
  <arg name="world" default="$(find mavlink_sitl_gazebo)/worlds/empty.world"/>
  <arg name="gui" default="true"/>
  <arg name="debug" default="false"/>
  <arg name="verbose" default="false"/>
  <arg name="paused" default="false"/>

  <arg name="home_lat" default="38.49859707"/>
  <arg name="home_lon" default="103.20623996"/>
  <arg name="home_alt" default="1401"/>
  <!-- groundtruth/GPS 插件（Gazebo 进程内）优先读这三个环境变量；
       env 必须写在 include 之前，子 include 才会继承。 -->
  <env name="PX4_HOME_LAT" value="$(arg home_lat)"/>
  <env name="PX4_HOME_LON" value="$(arg home_lon)"/>
  <env name="PX4_HOME_ALT" value="$(arg home_alt)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="world_name" value="$(arg world)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>

  <group ns="iris_0">
    <include file="$(find swarm_simulation)/launch/single_vehicle_spawn_seq.launch">
      <arg name="x" value="0.227584"/><arg name="y" value="-0.135758"/>
      <arg name="z" value="0.546696"/>
      <arg name="R" value="0"/><arg name="P" value="0"/><arg name="Y" value="-1.237860"/>
      <arg name="vehicle" value="iris"/><arg name="sdf" value="iris"/>
      <arg name="ID" value="0"/><arg name="ID_in_group" value="0"/>
      <arg name="mavlink_tcp_port" value="4560"/>
      <arg name="udp_gimbal_port" value="13030"/>
      <arg name="wait_for_model" value=""/>
      <arg name="interactive" value="true"/>
    </include>
  </group>

  <group ns="iris_1">
    <include file="$(find swarm_simulation)/launch/single_vehicle_spawn_seq.launch">
      <arg name="x" value="-5.319861"/><arg name="y" value="-1.876475"/>
      <arg name="z" value="0.182857"/>
      <arg name="R" value="0"/><arg name="P" value="0"/><arg name="Y" value="-1.037564"/>
      <arg name="vehicle" value="iris"/><arg name="sdf" value="iris"/>
      <arg name="ID" value="1"/><arg name="ID_in_group" value="1"/>
      <arg name="mavlink_tcp_port" value="4561"/>
      <arg name="udp_gimbal_port" value="13031"/>
      <arg name="wait_for_model" value="-wait iris_0"/>
      <arg name="interactive" value="true"/>
    </include>
  </group>

  <group ns="iris_2">
    <include file="$(find swarm_simulation)/launch/single_vehicle_spawn_seq.launch">
      <arg name="x" value="-9.445411"/><arg name="y" value="-5.004599"/>
      <arg name="z" value="0.852273"/>
      <arg name="R" value="0"/><arg name="P" value="0"/><arg name="Y" value="-1.232543"/>
      <arg name="vehicle" value="iris"/><arg name="sdf" value="iris"/>
      <arg name="ID" value="2"/><arg name="ID_in_group" value="2"/>
      <arg name="mavlink_tcp_port" value="4562"/>
      <arg name="udp_gimbal_port" value="13032"/>
      <arg name="wait_for_model" value="-wait iris_1"/>
      <arg name="interactive" value="true"/>
    </include>
  </group>

